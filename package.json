{
	"name": "cmdc-statusline",
	"version": "0.4.1",
	"description": "A status line mod for Command Code (cmdc): model, gradient context bar, cache hit rate, session cost, output speed, sub-agent usage, session name and git state.",
	"type": "module",
	"commandcode": {
		"mods": [
			"./index.ts"
		]
	},
	"files": [
		"index.ts",
		"scripts",
		"test",
		"README*.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"scripts": {
		"test": "node test/statusline.test.mjs",
		"tables:check": "python3 scripts/gen-model-tables.py --check",
		"tables:generate": "python3 scripts/gen-model-tables.py",
		"prepublishOnly": "node test/statusline.test.mjs"
	},
	"keywords": [
		"commandcode",
		"command-code",
		"cmdc",
		"statusline",
		"status-line",
		"mod",
		"cli"
	],
	"author": "holtwood",
	"license": "MIT",
	"engines": {
		"node": ">=22.18"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/holtwood/cmdc-statusline.git"
	},
	"homepage": "https://github.com/holtwood/cmdc-statusline#readme",
	"bugs": {
		"url": "https://github.com/holtwood/cmdc-statusline/issues"
	}
}
